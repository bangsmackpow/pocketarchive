# ---------------------------------------------------------------------------
# PocketArchive production stack
#
# Generate the required secrets before deploying:
#
#   openssl rand -base64 32   # ARCHIVE_MASTER_KEK (exactly 32 bytes)
#   openssl rand -base64 32   # SESSION_SECRET (>= 32 chars)
#   openssl rand -base64 32   # MEILI_MASTER_KEY
#   openssl rand -hex 24      # POSTGRES_PASSWORD (hex avoids URL-encoding in DATABASE_URL)
#
# Keep a secure offline copy of ARCHIVE_MASTER_KEK. Losing it makes archived
# blobs unrecoverable. Rotating it requires re-wrapping tenant KEKs.
# ---------------------------------------------------------------------------

# Required
POSTGRES_PASSWORD=replace-with-a-long-random-password
ARCHIVE_MASTER_KEK=replace-with-output-of-openssl-rand-base64-32
MEILI_MASTER_KEY=replace-with-a-long-random-key
SESSION_SECRET=replace-with-at-least-32-random-characters

# SMTP journaling (sender allowlist is mandatory unless IP allowlist or AUTH is used)
SMTP_ALLOWED_DOMAINS=yourcompany.com
SMTP_HOSTNAME=mail.yourcompany.com
SMTP_ALLOWED_IPS=
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=

# TLS certificate paths inside the engine container (leave blank for a
# self-signed development certificate)
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=

# First-run administrator. Remove these after the first successful login.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-With-A-Long-Password

# Tenant + retention defaults
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Archive
DEFAULT_RETENTION_DAYS=2557

# Optional tuning
LOG_LEVEL=info
WORKER_CONCURRENCY=2
MAX_UPLOAD_BYTES=5368709120
SMTP_MAX_MESSAGE_BYTES=104857600
ENGINE_IMAGE=ghcr.io/bangsmackpow/pocketarchive-engine:latest
WEB_IMAGE=ghcr.io/bangsmackpow/pocketarchive-web:latest
