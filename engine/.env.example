# Run the engine from the repository root with `cd engine && go run ./cmd/engine serve`.
# Generate secrets with:
#   openssl rand -base64 32
#   openssl rand -base64 32

DATABASE_URL=postgres://archive_app:devpassword@localhost:5432/archive?sslmode=disable
ARCHIVE_MASTER_KEK=replace-with-openssl-rand-base64-32
SESSION_SECRET=replace-with-at-least-32-random-characters

BLOB_STORAGE_PATH=../.data/blobs
SPOOL_PATH=../.data/spool

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=devmasterkey
MEILI_INDEX=messages
VALKEY_URL=redis://localhost:6379

DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Archive
DEFAULT_RETENTION_DAYS=2557
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Now-123

API_ADDR=:8080
SMTP_ADDR=:2525
SMTP_HOSTNAME=mail.archive.local
SMTP_ALLOWED_DOMAINS=example.com
SMTP_ALLOWED_IPS=
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=
SMTP_MAX_MESSAGE_BYTES=104857600

WORKER_CONCURRENCY=2
MAX_UPLOAD_BYTES=5368709120
LOG_LEVEL=info
ARCHIVE_ENV=development
